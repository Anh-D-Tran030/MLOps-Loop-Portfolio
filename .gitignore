# Model artifacts
*.pkl

# Data files
*.parquet
# Exception: reference_data.parquet is the PSI baseline and must be committed
!monitoring/evidently/reference_data.parquet

# Training data (Kaggle dataset — not committed); DVC pointer file IS committed
data/*
!data/*.dvc
!data/.gitignore

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Test + lint caches
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
*.log

# MLflow state — kept locally and via actions/cache in CI; do not commit contents
mlflow/*
!mlflow/.gitkeep

# Feast-generated state (registry + online store SQLite files)
feature_repo/data/

# HuggingFace model cache
transformers_cache/

# Environment variables
.env
.env.*

# Node (if any tooling requires it)
node_modules/

# IDE
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store

# Agent / editor workspace metadata
.agent-context/
.claude/
